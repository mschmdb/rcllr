{
  "name": "site",
  "private": true,
  "type": "module",
  "description": "rcllr.schmidbauer.dev: docs and landing page, built from README, CHANGELOG and the CLI help.",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "pnpm content && vite dev",
    "build": "pnpm content && vite build && node scripts/check-build.ts",
    "preview": "vite preview",
    "check": "pnpm content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test 'src/**/*.test.ts'",
    "sync-tokens": "node scripts/sync-tokens.mjs",
    "content": "node --conditions=source --disable-warning=ExperimentalWarning scripts/content.ts",
    "og-image": "node --disable-warning=ExperimentalWarning scripts/og-image.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lucide/svelte": "^1.61.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "marked": "18.1.1",
    "playwright": "^1.64.1",
    "rcllr": "workspace:*",
    "shiki": "4.5.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
